    { "source": "/n3/:path*", "destination": "https://nigraan-api.aigeo360.com/n3/:path*" },
    { "source": "/tiles/:path*", "destination": "https://nigraan-api.aigeo360.com/tiles/:path*" },
    { "source": "/health", "destination": "https://nigraan-api.aigeo360.com/health" },
    { "source": "/customize/sites", "destination": "https://nigraan-api.aigeo360.com/customize/sites" },
    { "source": "/px/:path*", "destination": "https://nigraan-api.aigeo360.com/px/:path*" },
    { "source": "/archive/:path*", "destination": "https://nigraan-api.aigeo360.com/archive/:path*" },
    { "source": "/agn-:file*", "destination": "https://nigraan-api.aigeo360.com/agn-:file*" }
