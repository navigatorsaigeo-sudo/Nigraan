# Copy to ai.key (next to mach.key) to switch the AI Decision tab from retrieval to a local model.
# The key file is read on the server only; nothing here is sent to the browser.
provider=ollama
model=qwen3:1.7b
base=http://127.0.0.1:11434/v1
# gpt-oss:20b when 16 GB of RAM is free:  ollama pull gpt-oss:20b   then  model=gpt-oss:20b
# Small models: the server turns thinking off and asks for low reasoning effort (v91.17.42).
