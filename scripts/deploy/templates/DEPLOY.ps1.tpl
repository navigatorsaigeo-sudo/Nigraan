# NIGRAAN v@FULL@ (@DATE@) - ZERO-DOWNTIME DEPLOY over the live v@BASEFULL@. Run from DEPLOY_V@VU@.bat.
# Generated by scripts\deploy\mkdeploy.mjs from scripts\deploy\templates\DEPLOY.ps1.tpl (ASCII only: Windows PowerShell 5.1 reads a
# .ps1 without a byte-order mark as ANSI). What this release brings: @SUMMARY@
# No administrator rights. No outage: the supervisor starts the new server beside the running one and the front proxy on 8787 switches
# only when the new one is warm (the package carries D:\NIGRAAN\_admin\deploy_swap.ps1 and runs that copy).
# The package folder is D:\NIGRAAN\_admin\step2\v@VU@:
#   new\nigraan-local\..., new\_admin\...   the staged files;  SHA256SUMS.txt, EXPECTED_prev_SHA256.txt, bak\DEPLOY_V@VU@_FILES.txt
# Steps: 1 checks (nothing changed if one fails): every package file matches SHA256SUMS.txt (the package is complete and unchanged);
#   every file it replaces on this computer is the one EXPECTED_prev_SHA256.txt names for the base (@BASES@) - anything else is
#   refused; layout; deploy_swap -CheckOnly. 2 copy (each replaced file kept as <name>.b@VD@.bak; the deploy journal
#   nigraan-local\data\run\deploy-journal.json is written before the first copy) + swap; 3 warm, live checks; any failure rolls back
#   by itself (no gap), and every failed check logs WHY; the journal is marked active only when every check passed;
#   4 REMOVED items moved to _admin\archive (never deleted); 5 appends the release entry to NIGRAAN_STATUS_REPORT.md.
# RESUMABLE (v91.17.283, WS3): run it again after an interruption (the window closed, a restart, a power cut) and it continues:
#   - the files are in place and the server already answers @FULL@: the live checks run again (and the journal is marked active);
#   - already deployed and marked active: it says so and exits 0;
#   - anything in between: ROLLBACK_V@VU@ first puts the install back on the base (the supervisor may already have done that at the
#     restart), then the deploy runs again from the start.
# Exit: 0 deployed, 1 failed and rolled back, 2 refused (nothing changed).
param([string]$Root = 'D:\NIGRAAN', [string]$Pkg = '', [string]$Base = 'http://127.0.0.1:8787', [int]$WarmMinutes = 20)
$ErrorActionPreference = 'Continue'
function J($a, $b) { [IO.Path]::Combine($a, ($b -replace '[\\/]', [string][IO.Path]::DirectorySeparatorChar)) }   # Join-Path that also runs off Windows (tests)
if (-not $Pkg) { $Pkg = J $Root '_admin\step2\v@VU@' }
$VER = '@VD@'; $FULL = '@FULL@'
$NEW = J $Pkg 'new'
$DS2 = J $Pkg 'ds2'
$LIST = J $Pkg 'bak\DEPLOY_V@VU@_FILES.txt'
$NL = J $Root 'nig\nigraan-local'
$ARCH = J $Root '_admin\archive\v@VU@'
$LOG = J $Root '_admin\deploy_v@VU@.log'
$PAGE = 'AI_GEO_NIGRAAN_v91_17_MACH.html'
$SWAP = J $NEW '_admin\deploy_swap.ps1'
$PPORT = ([uri]$Base).Port
# REMOVED: nothing in v@FULL@ (the v278 move of server\api\airportsite.mjs is done; the step is kept, empty).
$REMOVED = @()
$MAPTOP = @{ 'nigraan-local' = 'nig\nigraan-local'; '_admin' = '_admin' }
function Pkt { [DateTime]::UtcNow.AddHours(5) }   # Pakistan time has no daylight saving
function Say($m) { $l = '[{0:yyyy-MM-dd HH:mm:ss} PKT] {1}' -f (Pkt), $m; Write-Host $l; try { Add-Content -LiteralPath $LOG -Value $l -Encoding ASCII } catch {} }
function Rec($kind, $a, $b) { Add-Content -LiteralPath $LIST -Value ("{0}`t{1}`t{2}" -f $kind, $a, $b) -Encoding ASCII }
function Sha($f) { (Get-FileHash -LiteralPath $f -Algorithm SHA256).Hash.ToLower() }
# v276: Get-Url returns status, json, body, the parse error (ConvertFrom-Json of this PowerShell), the network error and the time taken
function Get-Url($path, [int]$timeoutMs = 60000, [string]$method = 'GET') {
  $sw = [Diagnostics.Stopwatch]::StartNew(); $t = $null; $code = 0; $neterr = $null
  try { $q = [Net.HttpWebRequest]::Create($Base + $path); $q.Proxy = $null; $q.Timeout = $timeoutMs; $q.ReadWriteTimeout = $timeoutMs; $q.Headers.Add('Sec-Fetch-Site', 'same-origin')
    if ($method -ne 'GET') { $q.Method = $method; $q.ContentType = 'application/json'; $bb = [Text.Encoding]::ASCII.GetBytes('{}'); $q.ContentLength = $bb.Length; $st = $q.GetRequestStream(); $st.Write($bb, 0, $bb.Length); $st.Close() }
    $r = $q.GetResponse()
    $sr = New-Object IO.StreamReader($r.GetResponseStream()); $t = $sr.ReadToEnd(); $code = [int]$r.StatusCode; $r.Close() }
  catch [Net.WebException] { $neterr = $_.Exception.Message
    if ($_.Exception.Response) { try { $code = [int]$_.Exception.Response.StatusCode; $sr = New-Object IO.StreamReader($_.Exception.Response.GetResponseStream()); $t = $sr.ReadToEnd() } catch {}; try { $_.Exception.Response.Close() } catch {} } }
  catch { $neterr = $_.Exception.Message }
  $j = $null; $perr = $null
  if ($null -ne $t) { try { $j = $t | ConvertFrom-Json -ErrorAction Stop } catch { $perr = $_.Exception.Message } }
  return @{ status = $code; json = $j; body = $t; parseError = $perr; netError = $neterr; ms = [int]$sw.ElapsedMilliseconds }
}
# v276: why a live check failed, in one line: status, time, ok value, why/error fields, parse or network error, first 400 characters of the body
function Why-Of($r) {
  $p = @(('status {0}' -f $r.status), ('{0} ms' -f $r.ms))
  if ($r.json) { $okv = $r.json.ok; $p += ('ok=' + $(if ($null -eq $okv) { '(absent)' } else { [string]$okv }))
    foreach ($k in @('why', 'error', 'reason')) { $v = $r.json.$k; if ($null -ne $v -and "$v" -ne '') { $s = ("$v" -replace '\s+', ' '); $p += ('{0}="{1}"' -f $k, $s.Substring(0, [Math]::Min(300, $s.Length))) } } }
  elseif ($null -ne $r.body) { $p += 'the body did not parse as JSON' }
  if ($r.parseError) { $p += ('parse error: ' + ($r.parseError -replace '\s+', ' ')) }
  if ($r.netError) { $p += ('network: ' + ($r.netError -replace '\s+', ' ')) }
  if ($null -ne $r.body) { $b = ($r.body -replace '\s+', ' '); $p += ('{0} bytes, body starts: {1}' -f $r.body.Length, $b.Substring(0, [Math]::Min(400, $b.Length))) } else { $p += 'no body' }
  return ($p -join '; ')
}
function Check-Fail($name, $r) { $w = Why-Of $r; Say ('live check FAILED: ' + $name + ': ' + $w); return ('{0} ({1})' -f $name, $w.Substring(0, [Math]::Min(160, $w.Length))) }
function PS-Exe { $p = (Get-Process -Id $PID).Path; if ($p) { return $p }; return 'powershell' }
# v279 OPS-02: never start the ROLLBACK swap while the supervisor is still busy with the deploy's swap (data\run\supervisor.lock busy:true)
function Wait-SupervisorIdle {
  $lf = J $NL 'data\run\supervisor.lock'
  for ($i = 0; $i -lt 900; $i++) { try { $o = Get-Content -Raw -LiteralPath $lf | ConvertFrom-Json; if (-not $o.busy) { return } } catch { return }; Start-Sleep 2 }
  Say 'the supervisor was still busy after 30 minutes; ROLLBACK runs anyway (its swap waits for the supervisor)'
}
# v91.17.283 (WS3): the deploy journal deploy_swap.ps1 writes (nigraan-local\data\run\deploy-journal.json); this script marks it active
$JOUR = J $NL 'data\run\deploy-journal.json'
function Read-Journal { try { return (Get-Content -Raw -LiteralPath $JOUR -ErrorAction Stop | ConvertFrom-Json) } catch { return $null } }
function Set-JournalState($st, $note) {
  $j = Read-Journal; if (-not $j -or [string]$j.version -ne $VER) { return }
  $j.state = $st; $j.updatedAt = (Get-Date).ToUniversalTime().ToString('o')
  if ($null -eq $j.PSObject.Properties['note']) { $j | Add-Member -NotePropertyName note -NotePropertyValue $null }
  $j.note = [string]$note
  try { $tmp = $JOUR + '.' + $PID + '.tmp'; $b = (New-Object Text.UTF8Encoding($false)).GetBytes(($j | ConvertTo-Json -Depth 6))
    $fs = [IO.File]::Open($tmp, [IO.FileMode]::Create, [IO.FileAccess]::Write, [IO.FileShare]::None); try { $fs.Write($b, 0, $b.Length); $fs.Flush($true) } finally { $fs.Close() }
    Move-Item -LiteralPath $tmp -Destination $JOUR -Force } catch { Say ('deploy journal not marked ' + $st + ': ' + $_.Exception.Message) }
}
$script:RESUME = $false
function Rollback($why) {
  Say ("FAILED: " + $why)
  Say 'running ROLLBACK_V@VU@.ps1 (every replaced file back from its .b@VD@.bak copy, new files moved aside, one more swap: no gap)'
  $rb = J $PSScriptRoot 'ROLLBACK_V@VU@.ps1'
  & (PS-Exe) -NoProfile -ExecutionPolicy Bypass -File $rb -Root $Root -Pkg $Pkg -Base $Base -Why $why | Out-Null
  $rc = $LASTEXITCODE
  if ($rc -eq 0) { Say ('NOT DEPLOYED: v@VD@ was rolled back; NIGRAAN runs v{0} as before. Send this log.' -f $script:PREV) } else { Say "NOT DEPLOYED and the rollback reported a problem (exit $rc): see the lines above. Send this log." }
  exit 1
}

Say "==== DEPLOY_V@VU@ start (NIGRAAN v$FULL, zero-downtime, no administrator rights)"
Say ("user {0}, package {1}, install {2}" -f $env:USERNAME, $Pkg, $Root)
$now = Pkt
if (-not ($now.Hour -ge 2 -and $now.Hour -lt 5)) { Say ("note: {0:HH:mm} PKT is outside 02:00-05:00 PKT. The swap has no gap (customers are served throughout), so the deploy continues." -f $now) }
else { Say ("inside the quiet window ({0:HH:mm} PKT)" -f $now) }

# ---- 1 checks (nothing changed if one fails)
foreach ($p in @($NEW, $NL, $SWAP)) { if (-not (Test-Path -LiteralPath $p)) { Say "REFUSED: $p is missing. Nothing was changed."; exit 2 } }
$sums = J $Pkg 'SHA256SUMS.txt'
if (-not (Test-Path -LiteralPath $sums)) { Say "REFUSED: $sums is missing. Nothing was changed."; exit 2 }
$want = @{}
foreach ($line in (Get-Content -LiteralPath $sums)) { if ($line -match '^([0-9a-f]{64})\s+\*?\.?/?(.+)$') { $want[($Matches[2] -replace '/', '\')] = $Matches[1] } }
$all = @()
foreach ($top in @('new', 'ds2')) { $d = J $Pkg $top; if (-not (Test-Path -LiteralPath $d)) { continue }; $all += @(Get-ChildItem -LiteralPath $d -Recurse -File | ForEach-Object { [pscustomobject]@{ src = $_.FullName; rel = ($_.FullName.Substring($Pkg.TrimEnd('\', '/').Length).TrimStart('\', '/') -replace '/', '\') } }) }
$bad = @()
foreach ($f in $all) { if (-not $want.ContainsKey($f.rel)) { $bad += ($f.rel + ' (not in SHA256SUMS.txt)') } elseif ((Sha $f.src) -ne $want[$f.rel]) { $bad += ($f.rel + ' (sha256 differs)') } }
foreach ($k in $want.Keys) { if (-not (Test-Path -LiteralPath (J $Pkg $k))) { $bad += ($k + ' (missing from the package)') } }
if ($bad.Count) { Say ('REFUSED: the package is not complete or was changed: ' + ($bad -join '; ') + '. Nothing was changed.'); exit 2 }
Say ("package verified: {0} files match SHA256SUMS.txt" -f $want.Count)
# laptop path of every staged / ds2 file
$items = @()
foreach ($f in $all) {
  $parts = $f.rel -split '\\', 3
  if ($parts[0] -eq 'new') { if (-not $MAPTOP.ContainsKey($parts[1])) { Say ("REFUSED: staged file outside nigraan-local\ or _admin\: " + $f.rel + '. Nothing was changed.'); exit 2 }; $lr = $MAPTOP[$parts[1]] + '\' + $parts[2] }
  else { $lr = 'nig\ds2\' + ($f.rel.Substring(4)) }
  $items += [pscustomobject]@{ src = $f.src; rel = $f.rel; lr = $lr; dst = (J $Root $lr); ds2 = ($parts[0] -eq 'ds2') }
}
$forbidden = @($items | Where-Object { $_.lr -like 'nig\station-lake\*' -or $_.lr -like 'nig\nigraan-local\scripts\wd\watchdog*.cmd' -or $_.lr -eq 'nig\nigraan-local\server\proxy.mjs' })
if ($forbidden.Count) { Say ('REFUSED: the package would write ' + (($forbidden | ForEach-Object { $_.lr }) -join ', ') + '. Nothing was changed.'); exit 2 }
# the install must hold ONE of the bases this package was merged against (v@BASE@): EXPECTED_prev_SHA256.txt has a '# set <ver>'
# block per base with that base's file for every file the package replaces (64 dashes = the base has no such file). Each block is checked
# against this computer; the first block that matches entirely is the base (a file already equal to the package one counts as matching);
# test files that differ are noted, not refused (as before). No block matches -> REFUSED, nothing changed.
$exp = J $Pkg 'EXPECTED_prev_SHA256.txt'
if (-not (Test-Path -LiteralPath $exp)) { Say "REFUSED: $exp is missing. Nothing was changed."; exit 2 }
$byLr = @{}; foreach ($i in $items) { $byLr[$i.lr] = $i }
$sets = [ordered]@{}; $cs = $null
foreach ($line in (Get-Content -LiteralPath $exp)) {
  if ($line -match '^#\s*set\s+(\S+)') { $cs = $Matches[1]; $sets[$cs] = New-Object System.Collections.ArrayList; continue }
  if ($null -eq $cs -or $line -notmatch '^([0-9a-f]{64}|-{64})\s+\*?(.+)$') { continue }
  [void]$sets[$cs].Add(@($Matches[1], ($Matches[2] -replace '/', '\')))
}
if (-not $sets.Count) { Say "REFUSED: $exp lists no base. Nothing was changed."; exit 2 }
$script:PREV = $null; $report = @(); $driftTests = @()
foreach ($k in $sets.Keys) {
  $drift = @(); $dt = @()
  foreach ($e in $sets[$k]) { $lr = $e[1]; $dst = J $Root $lr; $pk = if ($byLr.ContainsKey($lr)) { Sha $byLr[$lr].src } else { '' }
    if (-not (Test-Path -LiteralPath $dst)) { continue }
    $cur = Sha $dst; $okf = ($cur -eq $e[0]) -or ($cur -eq $pk)
    if (-not $okf) { if ($lr -like 'nig\nigraan-local\scripts\tests*' -or $lr -like '_admin\tests\*') { $dt += $lr } else { $drift += $lr } } }
  if (-not $drift.Count) { $script:PREV = $k; $driftTests = $dt; break }
  $report += ('v{0}: {1} file(s) differ ({2}{3})' -f $k, $drift.Count, (($drift | Select-Object -First 4) -join ', '), $(if ($drift.Count -gt 4) { ', ...' } else { '' }))
}
if (-not $script:PREV) { Say ('REFUSED: this computer does not hold v@BASE@ for the files this package replaces: ' + ($report -join '; ') + '. Nothing was changed. Send this log.'); exit 2 }
if ($driftTests.Count) { Say ('note: test files differ from v{0} on this computer and will be replaced (old ones kept as *.b@VD@.bak): {1}' -f $script:PREV, ($driftTests -join ', ')) }
Say ('the install holds the v{0} version of every file the package replaces (base v91.17.{0})' -f $script:PREV)
$h0 = Get-Url '/health' 15000
# v91.17.283 (WS3) RESUMABLE: a record of an earlier run of this deploy (see the header)
if ((Test-Path -LiteralPath $LIST) -and (@(Get-Content -LiteralPath $LIST | Where-Object { $_ -match '^(REPLACED|NEW|SWAP|MOVED)' }).Count)) {
  $jr = Read-Journal; $jst = if ($jr -and [string]$jr.version -eq $VER) { [string]$jr.state } else { '(no journal)' }
  $notIn = @($items | Where-Object { -not $_.ds2 -and (-not (Test-Path -LiteralPath $_.dst) -or (Sha $_.dst) -ne (Sha $_.src)) })
  $servesNew = ($h0.status -eq 200 -and $h0.json -and [string]$h0.json.serviceVersion -eq ($FULL + '-local'))
  if (-not $notIn.Count -and $servesNew -and $jst -eq 'active') { Say ("ALREADY DEPLOYED: every package file is in place, the server answers {0} and the deploy journal is active. Nothing to do." -f $FULL); exit 0 }
  if (-not $notIn.Count -and $servesNew) {
    Say ("RESUME: an earlier run copied and swapped (journal state '{0}'); the server answers {1}: the live checks run again" -f $jst, $FULL); $script:RESUME = $true
    $bl = @(Get-Content -LiteralPath $LIST | Where-Object { $_ -match '^BASE\t' } | Select-Object -First 1); if ($bl.Count) { $script:PREV = ($bl[0] -split "`t")[1] }
  } else {
    Say ("RESUME: an earlier run of DEPLOY_V@VU@ did not finish (journal state '{0}'; {1} package file(s) not in place; the server answers {2}): ROLLBACK_V@VU@ puts the install back on the base first, then the deploy runs again from the start" -f $jst, $notIn.Count, $(if ($h0.json) { $h0.json.serviceVersion } else { 'nothing' }))
    $rb = J $PSScriptRoot 'ROLLBACK_V@VU@.ps1'
    & (PS-Exe) -NoProfile -ExecutionPolicy Bypass -File $rb -Root $Root -Pkg $Pkg -Base $Base -Why 'DEPLOY_V@VU@ resume' | Out-Null
    $rc = $LASTEXITCODE
    if ($rc -ne 0) { Say "NOT DEPLOYED: the rollback before the new attempt reported a problem (exit $rc); see the lines above. Send this log."; exit 1 }
    if (Test-Path -LiteralPath $LIST) { Say "REFUSED: $LIST is still there after the rollback. Nothing more was changed. Send this log."; exit 2 }
    $h0 = Get-Url '/health' 15000
    foreach ($i in $items) { if (-not $i.ds2 -and (Test-Path -LiteralPath $i.dst)) { $cur = Sha $i.dst; $okb = $false; foreach ($k in $sets.Keys) { foreach ($e in $sets[$k]) { if ($e[1] -eq $i.lr -and $e[0] -eq $cur) { $okb = $true } } }; if (-not $okb -and $cur -ne (Sha $i.src)) { Say ("REFUSED: after the rollback {0} is not the base file. Send this log." -f $i.lr); exit 2 } } }
    Say 'the install is back on the base: the deploy starts again'
  }
}
if ($h0.status -ne 200 -or -not $h0.json) { Say "REFUSED: $Base/health does not answer (status $($h0.status)). Nothing was changed."; exit 2 }
if (-not $h0.json.role -or [int]$h0.json.port -eq 8787) { Say 'REFUSED: the zero-downtime layout (front proxy on 8787, servers on 8791/8792) is not running; v@VD@ deploys only into it (v269 switched it). Nothing was changed.'; exit 2 }
Say ("the server answers: status {0}, version {1}, server port {2}, role {3}" -f $h0.json.status, $h0.json.serviceVersion, $h0.json.port, $h0.json.role)
if (-not $script:RESUME) {
$o = & (PS-Exe) -NoProfile -ExecutionPolicy Bypass -File $SWAP -Root $Root -Version $VER -Stage $NEW -ProxyPort $PPORT -OwnerPid $PID -Force -CheckOnly 2>&1 | Out-String
$rc = $LASTEXITCODE
($o -split "`r?`n") | Where-Object { $_ } | ForEach-Object { Say ('  ' + $_) }
if ($rc -ne 0) { Say "REFUSED by deploy_swap.ps1 -CheckOnly (exit $rc). Nothing was changed."; exit 2 }
New-Item -ItemType Directory -Force -Path (Split-Path -Parent $LIST) | Out-Null
Set-Content -LiteralPath $LIST -Value ("# DEPLOY_V@VU@ {0:yyyy-MM-dd HH:mm:ss} PKT  kind<TAB>laptop path<TAB>detail   (read by ROLLBACK_V@VU@.ps1)" -f (Pkt)) -Encoding ASCII
Rec 'BASE' $script:PREV ''   # v@VD@: the version this install held (the rollback swaps back naming it)
$nRep = 0; $nNew = 0; $nSame = 0
foreach ($i in @($items | Where-Object { -not $_.ds2 } | Sort-Object lr)) {
  if (Test-Path -LiteralPath $i.dst) { if ((Sha $i.dst) -eq (Sha $i.src)) { Rec 'SAME' $i.lr ''; $nSame++ } else { Rec 'REPLACED' $i.lr ($i.lr + '.b@VD@.bak'); $nRep++ } }
  else { Rec 'NEW' $i.lr ''; $nNew++ }
}
Say ("to copy: {0} replaced (kept as *.b@VD@.bak), {1} new, {2} already identical" -f $nRep, $nNew, $nSame)

# ---- 2 copy + swap (deploy_swap.ps1: copies, keeps .b@VD@.bak, asks the supervisor; on a failed swap it puts the files back itself)
Rec 'SWAP' 'started' ''
$o = & (PS-Exe) -NoProfile -ExecutionPolicy Bypass -File $SWAP -Root $Root -Version $VER -Stage $NEW -ProxyPort $PPORT -OwnerPid $PID -Force -WaitMinutes 30 2>&1 | Out-String
$rc = $LASTEXITCODE
($o -split "`r?`n") | Where-Object { $_ } | ForEach-Object { Say ('  ' + $_) }
Rec 'SWAP' $rc ''
if ($rc -eq 2) { Say 'NOT DEPLOYED: deploy_swap.ps1 refused before copying (exit 2). Nothing was changed.'; Rename-Item -LiteralPath $LIST -NewName ('DEPLOY_V@VU@_FILES.refused-' + (Get-Date -Format 'yyyyMMddHHmmss') + '.txt') -ErrorAction SilentlyContinue; exit 2 }
if ($rc -eq 3) { Wait-SupervisorIdle; Rollback "deploy_swap.ps1 ended with exit 3: the swap switched to the new server and then failed (or the new server is serving after a timeout); the files were NOT put back under it. ROLLBACK restores them and swaps once more" }
if ($rc -ne 0) { Wait-SupervisorIdle; Rollback "deploy_swap.ps1 ended with exit $rc (1 = the swap failed before the switch and it put the files back; 4 = no answer and the old server still serves: files put back)" }
foreach ($i in @($items | Where-Object { -not $_.ds2 })) { if (-not (Test-Path -LiteralPath $i.dst) -or (Sha $i.dst) -ne (Sha $i.src)) { Rollback ("after the copy {0} does not match the package" -f $i.lr) } }
Say 'every staged file is in place and matches the package'
} else { Say 'resume: copy and swap were done by the earlier run' }

# ---- 3 warm, then live checks
$t0 = Get-Date; $h = $null
while (((Get-Date) - $t0).TotalMinutes -lt $WarmMinutes) { $r = Get-Url '/health' 15000; if ($r.status -eq 200 -and $r.json -and $r.json.warm -eq $true -and $r.json.status -ne 'starting') { $h = $r.json; break }; Start-Sleep 3 }
if (-not $h) { Rollback ("the server did not report warm:true within $WarmMinutes minutes (last /health: " + (Why-Of $r) + ")") }
Say ("warm: status {0}, role {1}, server port {2} (was {3}), pid {4}, version {5}" -f $h.status, $h.role, $h.port, $h0.json.port, $h.pid, $h.serviceVersion)
$fail = @()
if ($h.role -ne 'active') { $fail += ('health role is ' + $h.role + ', not active') }
if ([string]$h.serviceVersion -ne ($FULL + '-local')) { $fail += ("health version is '{0}', not {1}-local" -f $h.serviceVersion, $FULL) } else { Say ("health version {0}" -f $h.serviceVersion) }
if ($null -eq $h.copiesRetention) { $fail += '/health does not show copiesRetention (the monthly copies move)' } else { Say ('health copiesRetention: ' + (($h.copiesRetention | ConvertTo-Json -Compress -Depth 3) -replace '\s+', ' ')) }
if ($null -eq $h.accMon) { $fail += '/health does not show accMon (the accuracy monitor)' } else { Say ('health accMon: ' + (($h.accMon | ConvertTo-Json -Compress -Depth 3) -replace '\s+', ' ')) }
if (-not $script:RESUME -and [int]$h.port -eq [int]$h0.json.port -and [int]$h.pid -eq [int]$h0.json.pid) { $fail += 'the same server still answers (no swap happened)' }
$mf = Get-Content -Raw -LiteralPath (J $NL 'artefact\MANIFEST.json') | ConvertFrom-Json
$mfSha = $mf.$PAGE.sha256; $diskSha = Sha (J $NL ('artefact\' + $PAGE)); $pkgSha = $want[('new\nigraan-local\artefact\' + $PAGE)]
if (-not $pkgSha) { $pkgSha = $diskSha }   # the page is not in the package (unchanged): disk = MANIFEST = served
$m = Get-Url '/api/manifest' 30000
$served = if ($m.json) { $m.json.files.$PAGE } else { $null }
