# v278.1 (FIX2781 1): station status right after a start. Live 17 Oct 19:36-19:42 PKT the past-30-days answer for Lahore called every MACH
# station "No reading received from this station yet." for 5 min after the v278 deploy while /api/fleet/check already said checked. Now
# no past-30-days row may say "No reading received" for a station the fleet check does not call silent. When the fleet's first poll has
# not finished yet (stations pending), it waits up to 120 s for it and asks the past 30 days again (an answer built before must not be kept).
$fst = Get-Url '/api/fleet/status' 30000; $fc = Get-Url '/api/fleet/check' 30000
