foreach ($rel in $REMOVED) {
  $src = J $Root $rel
  if (-not (Test-Path -LiteralPath $src)) { continue }   # v276: already absent on this computer (nothing to move; no line)
  $dst = J $ARCH $rel; if (Test-Path -LiteralPath $dst) { $dst = $dst + '.' + (Get-Date -Format 'yyyyMMddHHmmss') }
  try { New-Item -ItemType Directory -Force -Path (Split-Path -Parent $dst) | Out-Null; Move-Item -LiteralPath $src -Destination $dst -ErrorAction Stop; Rec 'MOVED' $rel $dst; $nMoved++; Say "moved $rel -> $dst" }
  catch { Say ("could not move {0}: {1} (left in place; harmless)" -f $rel, $_.Exception.Message) }
}
if (-not $nMoved) { Say 'REMOVED: nothing to move in v@VD@' }
$nd = 0
foreach ($i in @($items | Where-Object { $_.ds2 })) {
  try {
    if (Test-Path -LiteralPath $i.dst) { if ((Sha $i.dst) -eq (Sha $i.src)) { continue }; $bak = $i.dst + '.b@VD@.bak'; if (-not (Test-Path -LiteralPath $bak)) { Copy-Item -LiteralPath $i.dst -Destination $bak -ErrorAction Stop }; Rec 'DS2REPLACED' $i.lr ($i.lr + '.b@VD@.bak') }
    else { New-Item -ItemType Directory -Force -Path (Split-Path -Parent $i.dst) | Out-Null; Rec 'DS2NEW' $i.lr '' }
    Copy-Item -LiteralPath $i.src -Destination $i.dst -Force -ErrorAction Stop; $nd++
  } catch { Say ("ds2: could not copy {0}: {1} (the server does not use it; copy it by hand later)" -f $i.lr, $_.Exception.Message) }
}
Say ("ds2: {0} offline fit file(s) copied to {1}" -f $nd, (J $Root 'nig\ds2'))

# ---- 5 status report
$sr = J $Root 'NIGRAAN_STATUS_REPORT.md'; $entry = J $Root '_admin\docs\STATUS_V@VU@_ENTRY.md'
if (@(Get-Content -LiteralPath $LIST -ErrorAction SilentlyContinue | Where-Object { $_ -match '^STATUS\t' }).Count) { Say 'status report: the entry was appended by the earlier run' }
elseif ((Test-Path -LiteralPath $sr) -and (Test-Path -LiteralPath $entry)) {
  try { if (-not (Test-Path -LiteralPath ($sr + '.bak_v@VU@'))) { Copy-Item -LiteralPath $sr -Destination ($sr + '.bak_v@VU@') -ErrorAction Stop }
    $txt = (Get-Content -Raw -LiteralPath $entry -Encoding UTF8) -replace 'Status: built, not deployed\.', ("Status: deployed {0:yyyy-MM-dd HH:mm} PKT by DEPLOY_V@VU@.bat (zero-downtime swap, live checks passed)." -f (Pkt))
    # v282.1 (FIX2821 G): the top of the status report names the CURRENT release (one marked block, replaced on every deploy from v282.1 on)
    $all = [IO.File]::ReadAllText($sr); $b0 = '<!-- agn-current-release -->'; $b1 = '<!-- /agn-current-release -->'
    $blk = $b0 + "`r`n" + ('**Current release: NIGRAAN v{0}**, deployed {1:yyyy-MM-dd HH:mm} PKT by DEPLOY_V@VU@.bat over v91.17.{2} (zero-downtime swap, live checks passed). The entry of each release follows at the end of this file; older summaries below describe their own day.' -f $FULL, (Pkt), $script:PREV) + "`r`n" + $b1
    $i0 = $all.IndexOf($b0); $i1 = $all.IndexOf($b1)
    if ($i0 -ge 0 -and $i1 -gt $i0) { $all = $all.Substring(0, $i0) + $blk + $all.Substring($i1 + $b1.Length) }
    else { $nl = $all.IndexOf("`n"); if ($nl -lt 0) { $all = $all + "`r`n`r`n" + $blk + "`r`n" } else { $all = $all.Substring(0, $nl + 1) + "`r`n" + $blk + "`r`n" + $all.Substring($nl + 1) } }
    # v283.8 (audit): the "Latest entry" line at the top named v268 long after; it now names this release (the first such line only)
    $le = [regex]'(?m)^\*\*Latest entry:\*\*[^\r\n]*'
    $all = $le.Replace($all, ('**Latest entry:** NIGRAAN v{0}, deployed {1:yyyy-MM-dd HH:mm} PKT; its entry is at the end of this file. The summaries below the current-release block describe their own day.' -f $FULL, (Pkt)), 1)
    [IO.File]::WriteAllText($sr, $all, (New-Object Text.UTF8Encoding($false)))
    [IO.File]::AppendAllText($sr, "`r`n" + $txt, (New-Object Text.UTF8Encoding($false)))
    Rec 'STATUS' 'NIGRAAN_STATUS_REPORT.md' 'NIGRAAN_STATUS_REPORT.md.bak_v@VU@'; Say 'NIGRAAN_STATUS_REPORT.md: v@VD@ entry appended (old copy kept as NIGRAAN_STATUS_REPORT.md.bak_v@VU@)' }
  catch { Say ('status report not updated: ' + $_.Exception.Message) }
} else { Say 'status report not updated (NIGRAAN_STATUS_REPORT.md or the v@VD@ entry not found)' }
Say ("DEPLOYED v{0}: {1} answers from the server on port {2} (role {3}). Undo if ever needed: D:\NIGRAAN\_admin\step2\ROLLBACK_V@VU@.bat" -f $FULL, $Base, $h.port, $h.role)
exit 0
