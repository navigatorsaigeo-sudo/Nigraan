elseif ($p3.status -eq 200 -and $p3.json -and $p3.json.ok -eq $true) {
  $nPend0 = @($fc.json.stations | Where-Object { $_.pending }).Count; $p3b = $p3
  $noPoll = ($fst.json -and $fst.json.configured -eq $true -and -not $fst.json.lastAt)
  if (($nPend0 -or $noPoll) -and $fst.json -and $fst.json.configured -eq $true) {
    $t3 = Get-Date; while (((Get-Date) - $t3).TotalSeconds -lt 120) { Start-Sleep 5; $fc = Get-Url '/api/fleet/check' 30000; $fs2 = Get-Url '/api/fleet/status' 30000
      if ($fc.json -and -not @($fc.json.stations | Where-Object { $_.pending }).Count -and $fs2.json -and $fs2.json.lastAt) { break } }
    $p3b = Get-Url '/api/report/past30?lat=31.5204&lon=74.3587' 90000
    Say ("fleet check: {0} station(s) were pending a first poll (fleet polled when asked: {3}); after {1:0} s {2} pending; past 30 days asked again" -f $nPend0, ((Get-Date) - $t3).TotalSeconds, @($fc.json.stations | Where-Object { $_.pending }).Count, $(if ($noPoll) { 'not yet' } else { 'yes' })) }
  $byName = @{}; foreach ($s in @($fc.json.stations)) { $byName[[string]$s.name] = $s }
  $wrong = @(); $rows = @(); foreach ($r in @($p3b.json.stations)) { $c = $byName[[string]$r.name]; $cs = if (-not $c) { 'not in the check' } elseif ($c.pending) { 'pending' } else { [string]$c.status }
    $rows += ('{0}: {1} / check {2}' -f $r.name, $(if ($r.status) { $r.status } else { '-' }), $cs)
    if ("$($r.statusNote)" -match 'No reading received' -and $cs -ne 'silent') { $wrong += $r.name } }
  if ($p3b.status -ne 200 -or -not $p3b.json -or $p3b.json.ok -ne $true) { $fail += (Check-Fail 'past 30 days (Lahore), asked again after the first fleet poll' $p3b) }
  elseif ($wrong.Count) { $fail += (Check-Fail ('past 30 days (Lahore) says "No reading received" for station(s) the fleet check does not call silent: ' + ($wrong -join ', ')) $p3b) }
  else { Say ('past 30 days Lahore station status agrees with the fleet check (no "No reading received" for a reporting station): ' + $(if ($rows.Count) { $rows -join '; ' } else { 'no station within 25 km' })) }
}
