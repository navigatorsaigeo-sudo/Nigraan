# Copy to .env and fill in, or just export these before `npm start`.
# The key is read by the SERVER process. It is never sent to the browser.
OPEN_METEO_API_KEY=
PORT=8787
HOST=127.0.0.1
# Which file in artefact/ is served at "/"
# The MACh build is what this server serves by default. Pointing this at the
# CLIENT build silently serves the un-rebranded artefact (v91.17.16, SEC-10).
NIGRAAN_ARTEFACT=AI_GEO_NIGRAAN_v91_17_MACH.html
# Password for the dashboard that issues the Operator mode and Customize token.
# Server only. A blank value keeps the dashboard closed.
NIGRAAN_DASHBOARD_PASSWORD=
